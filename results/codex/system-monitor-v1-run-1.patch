+.topbar, .panel-heading, .modal-header, .setting-row { display: flex; align-items: center; }
+.topbar, .panel-heading { justify-content: space-between; gap: 1rem; }
+.eyebrow { margin: 0 0 .25rem; color: var(--accent); font-size: .75rem; font-weight: 700; letter-spacing: .12em; }
+.topbar h1 { margin: 0; font-size: clamp(1.8rem, 5vw, 2.6rem); }
+.header-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
+button, input { font: inherit; }
+button { min-height: 2.5rem; padding: .5rem .8rem; border: 1px solid var(--border); border-radius: .4rem; color: var(--text); background: var(--surface); cursor: pointer; }
+button:hover { border-color: var(--accent); }
+button:focus-visible, input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+.metrics-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0; }
+.metric-card, .process-panel, .modal { border: 1px solid var(--border); border-radius: .75rem; background: var(--surface); box-shadow: 0 8px 24px rgb(15 23 42 / .08); }
+.metric-card { padding: 1rem; display: grid; gap: .3rem; }
+.metric-card strong { font-size: 1.7rem; }
+.metric-card small, .panel-heading p, .hint { color: var(--muted); }
+.metric-card.warning { border-color: var(--warning); background: var(--warning-bg); }
+.metric-card.critical { border-color: var(--critical); background: var(--critical-bg); }
+.process-panel { padding: 1.25rem; }
+.panel-heading { margin-bottom: 1rem; }
+.panel-heading h2 { margin: 0; }
+.panel-heading p { margin: .25rem 0 0; }
+input[type='search'] { width: min(100%, 20rem); min-height: 2.5rem; padding: .5rem .7rem; box-sizing: border-box; border: 1px solid var(--border); border-radius: .4rem; color: var(--text); background: var(--surface); }
+.table-wrapper { overflow-x: auto; }
+table { width: 100%; border-collapse: collapse; text-align: left; }
+th, td { padding: .85rem .7rem; border-bottom: 1px solid var(--border); white-space: nowrap; }
+th { color: var(--muted); font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; }
+th button { width: 100%; min-height: auto; padding: 0; border: 0; border-radius: 0; color: inherit; background: transparent; text-align: left; font: inherit; }
+th button:hover { color: var(--accent); }
+table.compact th, table.compact td { padding-block: .4rem; }
+.status-pill { display: inline-block; padding: .2rem .5rem; border-radius: 999px; font-size: .8rem; font-weight: 700; background: var(--surface-muted); }
+.status-pill.warning { color: var(--warning); background: var(--warning-bg); }
+.empty-state { padding: 2rem; color: var(--muted); text-align: center; }
+.modal-backdrop { position: fixed; z-index: 1; inset: 0; display: grid; place-items: center; padding: 1rem; background: rgb(0 0 0 / .5); }
+.modal { width: min(100%, 30rem); padding: 1.25rem; }
+.modal-header { justify-content: space-between; gap: 1rem; }
+.modal-header h2 { margin: 0; }
+.icon-button { width: 2.5rem; padding: 0; font-size: 1.5rem; line-height: 1; }
+.setting-row { justify-content: space-between; gap: 1rem; margin: 1.5rem 0 1rem; }
+.setting-row input { width: 1.2rem; height: 1.2rem; accent-color: var(--accent); }
+.hint { margin: 0; }
+
+@media (max-width: 760px) {
+  .app { padding: 1rem; }
+  .topbar, .panel-heading { align-items: stretch; flex-direction: column; }
+  .header-actions { width: 100%; }
+  .header-actions button { flex: 1; }
+  .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 1rem 0; }
+  .process-panel { padding: 1rem; }
+  input[type='search'] { width: 100%; }
+  .table-wrapper { overflow: visible; }
+  table, tbody, tr, td { display: block; }
+  thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+  table { border: 0; }
+  tbody { display: grid; gap: .75rem; }
+  tbody tr { padding: .6rem .8rem; border: 1px solid var(--border); border-radius: .5rem; background: var(--surface-muted); }
+  tbody td { display: flex; justify-content: space-between; gap: 1rem; padding: .35rem 0; border: 0; white-space: normal; text-align: right; }
+  table.compact tbody td { padding-block: .15rem; }
+  tbody td::before { content: attr(data-label); color: var(--muted); font-weight: 700; text-align: left; }
+  tbody .empty-state { display: block; text-align: center; }
+  tbody .empty-state::before { content: none; }
 }
